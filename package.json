{
  "name": "quantrisk-mcp",
  "version": "1.0.0",
  "description": "Quantitative Risk Analysis MCP Server - VaR, CVaR, Stress Testing, Correlation Regime Detection",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=neutral",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration.test.ts",
    "backtest": "npx tsx scripts/backtest.ts",
    "verify": "npx tsx scripts/verify-local.ts",
    "verify:deployed": "npx tsx scripts/verify-deployment.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "risk-analysis",
    "var",
    "cvar",
    "monte-carlo",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^4.0.15",
    "esbuild": "^0.27.1",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.15",
    "wrangler": "^4.53.0"
  }
}
